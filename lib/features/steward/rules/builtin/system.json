[
  {
    "id": "host.heap.high",
    "version": 1,
    "title": "堆占用超过 88%",
    "severity": "warning",
    "cooldownSec": 600,
    "shadowHours": 0,
    "enabledByDefault": true,
    "when": "host/tick",
    "if": {
      "gte": [
        "heapPct",
        88
      ]
    },
    "actions": [
      {
        "workflow": "wf.notify",
        "level": 1,
        "params": {
          "text": "宿主堆占用偏高"
        }
      }
    ]
  },
  {
    "id": "host.heap.critical",
    "version": 1,
    "title": "堆占用超过 92%",
    "severity": "critical",
    "cooldownSec": 300,
    "shadowHours": 0,
    "enabledByDefault": true,
    "when": "host/tick",
    "if": {
      "gte": [
        "heapPct",
        92
      ]
    },
    "actions": [
      {
        "workflow": "wf.host.protect",
        "level": 2,
        "params": {
          "text": "宿主堆进入危险区"
        }
      }
    ]
  },
  {
    "id": "host.loop.lag",
    "version": 1,
    "title": "事件循环 p99 超过 250ms",
    "severity": "warning",
    "cooldownSec": 600,
    "shadowHours": 0,
    "enabledByDefault": true,
    "when": "host/tick",
    "if": {
      "gte": [
        "loopP99Ms",
        250
      ]
    },
    "actions": [
      {
        "workflow": "wf.notify",
        "level": 1,
        "params": {
          "text": "事件循环被阻塞"
        }
      }
    ]
  },
  {
    "id": "host.disk.low",
    "version": 1,
    "title": "磁盘剩余不足 2GB",
    "severity": "error",
    "cooldownSec": 3600,
    "shadowHours": 0,
    "enabledByDefault": true,
    "when": "host/tick",
    "if": {
      "lt": [
        "freeDiskMB",
        2048
      ]
    },
    "actions": [
      {
        "workflow": "wf.notify",
        "level": 1,
        "params": {
          "text": "磁盘剩余空间过低"
        }
      }
    ]
  },
  {
    "id": "host.crash.new",
    "version": 1,
    "title": "出现新的崩溃日志",
    "severity": "critical",
    "cooldownSec": 300,
    "shadowHours": 0,
    "enabledByDefault": true,
    "when": "host/tick",
    "if": {
      "gte": [
        "crashLast24h",
        1
      ]
    },
    "actions": [
      {
        "workflow": "wf.notify",
        "level": 1,
        "params": {
          "text": "24 小时内出现崩溃日志"
        }
      }
    ]
  }
]
