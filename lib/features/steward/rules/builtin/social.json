[
  {
    "id": "social.question.stale",
    "version": 1,
    "title": "提问超过 15 分钟没答",
    "severity": "warning",
    "cooldownSec": 900,
    "shadowHours": 0,
    "enabledByDefault": true,
    "when": "agent/tick",
    "if": {
      "gte": [
        "questionAgeMs",
        900000
      ]
    },
    "actions": [
      {
        "workflow": "wf.ask",
        "level": 1,
        "params": {
          "text": "有一个提问挂了 15 分钟"
        }
      }
    ]
  },
  {
    "id": "social.report.hourly",
    "version": 1,
    "title": "每小时汇总一次",
    "severity": "info",
    "cooldownSec": 3300,
    "shadowHours": 0,
    "enabledByDefault": false,
    "when": "steward/tick",
    "if": {
      "gte": [
        "minuteOfHour",
        0
      ]
    },
    "actions": [
      {
        "workflow": "wf.digest",
        "level": 1,
        "params": {}
      }
    ]
  },
  {
    "id": "social.budget.exhausted",
    "version": 1,
    "title": "动作预算用尽",
    "severity": "warning",
    "cooldownSec": 1800,
    "shadowHours": 0,
    "enabledByDefault": true,
    "when": "steward/tick",
    "if": {
      "gte": [
        "budgetUsedPct",
        90
      ]
    },
    "actions": [
      {
        "workflow": "wf.notify",
        "level": 1,
        "params": {
          "text": "本小时动作预算接近上限"
        }
      }
    ]
  }
]
