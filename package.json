{
  "name": "polaris-toolkit",
  "version": "0.3.0",
  "private": true,
  "description": "Polaris Toolkit: one DSH host plugin hosting multiple features. Heap Guard is the first: host V8 heap observability, safe session slimming, bili budget control, and a pyramid dashboard with immediate-clean and auto-clean controls.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "docs",
    "install",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "skills",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.28.5",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "test": "node _test/all.mjs",
    "lint": "node _test/lint.mjs",
    "slim": "node bin/slim.mjs",
    "doctor": "node bin/polaris.mjs doctor",
    "polaris": "node bin/polaris.mjs",
    "polaris:install": "node bin/polaris.mjs install",
    "test:coverage": "node _test/all.mjs --coverage"
  },
  "license": "MIT"
}
